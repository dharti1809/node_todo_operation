<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Task</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
     <%- include('taskNavbar') %>

      <div class="container">
         <h1>Update Task</h1>

        <form class="todo-form" action="/update/<%= getResult._id %>" method="POST">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= getResult.title %>" required> <br> <br>

            <label for="description">Description:</label>
            <textarea id="description" name="description" required><%= getResult.description %></textarea> <br> <br>

            <button type="submit" class="button">Update Task</button>
        </form>
    </div>
</body>
</html>