<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Registration</title>

  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow">
        <div class="card-header text-center bg-primary text-white">
          <h4>User Update</h4>
        </div>

        <div class="card-body">
          <form action="/updateUser/<%= userData._id %>" method="POST" enctype="multipart/form-data">

            <!-- Full Name -->
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" name="fullname" class="form-control" value="<%= userData.fullname %>" placeholder="Enter full name" required>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label class="form-label">Email address</label>
              <input type="email" name="email" class="form-control" value="<%= userData.email %>" placeholder="Enter email" required>
            </div>

           
            <div class="mb-3">
              <label class="form-label">Mobile No</label>
              <input type="text" name="mobile_no" class="form-control" value="<%= userData.mobile_no %>" placeholder="Enter mobile number" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Profile Photo</label>
              <input type="file" name="profile_photo" class="form-control" value="<%= userData.profile_photo %>" placeholder="Enter profile photo URL" >
              <img src="/img/<%= userData.profile_photo %>" width="50"  height="40" alt="your image" class='profile mt-2'>
            </div>

            <!-- Gender -->
            <div class="mb-3">
              <label class="form-label">Gender</label><br>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="gender" value="Male" <%= userData.gender === "Male" ? "checked" : "" %>>
                <label class="form-check-label">Male</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="gender" value="Female" <%= userData.gender === "Female" ? "checked" : "" %> >
                <label class="form-check-label">Female</label>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Date of Birth</label>
              <input type="date" name="dob" class="form-control" value="<%= userData.dob %>" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Address</label>
              <textarea name="address" class="form-control" placeholder="Enter address" required><%= userData.address %></textarea>
            </div>

             <!-- Password -->
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control" value="<%= userData.password %>" placeholder="Enter password" required>
            </div>

           <div class="mb-3">
              <label class="form-label">Hobbies</label>
              <select name="hobbies" class="form-select" required>
                <option value="">--Select--</option>
                <option value="Reading" <%= userData.hobbies === "Reading" ? "selected" : "" %>>Reading</option>
                <option value="Traveling" <%= userData.hobbies === "Traveling" ? "selected" : "" %>>Traveling</option>
                <option value="Cooking" <%= userData.hobbies === "Cooking" ? "selected" : "" %>>Cooking</option>
                <option value="Sports" <%= userData.hobbies === "Sports" ? "selected" : "" %>>Sports</option>
                <option value="Music" <%= userData.hobbies === "Music" ? "selected" : "" %>>Music</option>
              </select>
             
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary">Update User</button>
            </div>

          </form>
        </div>

        <div class="card-footer text-center">
          Already have an account? <a href="/login">Login</a>
        </div>

      </div>

    </div>
  </div>
</div>

</body>
</html>